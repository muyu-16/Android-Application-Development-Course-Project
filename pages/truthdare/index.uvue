function draw() {
	const pool = questions[type.value][category.value]
	const content = pool[Math.floor(Math.random() * pool.length)]
	const title = (type.value === 'truth' ? '真心话' : '大冒险') + ' · ' +
				 (category.value === 'normal' ? '普通' : '刺激')

	uni.showModal({
		title: title,
		content: content,
		confirmText: '再来一次',
		cancelText: '关闭',
		success: (res) => {
			if (res.confirm) draw()
		}
	})
}
