<template>
	<view class="page">
		<text class="page-title">🎯 轮盘抽选</text>

		<view class="input-row">
			<input class="input" v-model="newOption" placeholder="输入新选项" @confirm="addOption" />
			<button class="btn-small btn-add" @tap="addOption">＋</button>
		</view>

		<button class="btn btn-primary" @tap="spin" :disabled="options.length === 0">
			🎡 开始抽选
		</button>

		<scroll-view class="list" scroll-y>
			<view class="list-item" v-for="(item, i) in options" :key="i"
				:class="{ highlighted: highlightIndex === i }">
				<text class="item-index">{{ i + 1 }}</text>
				<text class="item-text">{{ item }}</text>
				<text class="item-delete" @tap="deleteOption(i)">✕</text>
			</view>
			<view class="empty-tip" v-if="options.length === 0">
				<text>暂无选项，请添加</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'

const options = ref<string[]>([])
const newOption = ref('')
const highlightIndex = ref(-1)

onMounted(() => {
	const saved = uni.getStorageSync('wheel_options')
	if (saved) {
		try {
			options.value = JSON.parse(saved)
		} catch (e) {
			options.value = ['选项 1', '选项 2', '选项 3', '选项 4', '选项 5']
		}
	} else {
		options.value = ['选项 1', '选项 2', '选项 3', '选项 4', '选项 5']
	}
})

function save() {
	uni.setStorageSync('wheel_options', JSON.stringify(options.value))
}

function addOption() {
	const text = newOption.value.trim()
	if (!text) {
		uni.showToast({ title: '请输入选项', icon: 'none' })
		return
	}
	options.value.push(text)
	newOption.value = ''
	save()
}

function deleteOption(index: number) {
	options.value.splice(index, 1)
	highlightIndex.value = -1
	save()
}

function spin() {
	if (options.value.length === 0) {
		uni.showToast({ title: '选项列表为空', icon: 'none' })
		return
	}
	highlightIndex.value = -1
	setTimeout(() => {
		const idx = Math.floor(Math.random() * options.value.length)
		highlightIndex.value = idx
		uni.showToast({ title: '🎯 抽中：' + options.value[idx], icon: 'none' })
	}, 100)
}
</script>

<style>
.page { padding: 30rpx; background: #FFF5F5; min-height: 100vh; }
.page-title { font-size: 48rpx; font-weight: bold; color: #FF6B6B; margin-top: 40rpx; }
.input-row { display: flex; margin-top: 30rpx; gap: 16rpx; }
.input { flex: 1; height: 88rpx; background: white; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; border: 2rpx solid #DDD; }
.btn-small { width: 88rpx; height: 88rpx; line-height: 88rpx; border-radius: 16rpx; font-size: 40rpx; text-align: center; }
.btn-add { background: #FF6B6B; color: white; }
.btn { width: 100%; height: 100rpx; line-height: 100rpx; border-radius: 50rpx; font-size: 36rpx; font-weight: bold; margin-top: 24rpx; }
.btn-primary { background: #FF6B6B; color: white; }
.btn:disabled { opacity: 0.6; }
.list { margin-top: 20rpx; max-height: 60vh; }
.list-item { display: flex; align-items: center; background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.list-item.highlighted { background: #FFF176; }
.item-index { width: 60rpx; color: #888; font-size: 24rpx; }
.item-text { flex: 1; font-size: 28rpx; color: #333; }
.item-delete { width: 60rpx; text-align: center; color: #E53935; font-size: 32rpx; }
.empty-tip { text-align: center; color: #BBB; font-size: 28rpx; margin-top: 80rpx; }
</style>
