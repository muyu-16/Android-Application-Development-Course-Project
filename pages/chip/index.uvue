<template>
	<view class="page">
		<view class="action-bar">
			<text class="action-btn" @tap="undo">↩ 撤销</text>
			<text class="action-divider">|</text>
			<text class="action-btn" @tap="settle">🏆 结算</text>
		</view>

		<scroll-view class="list" scroll-y>
			<view class="player-card" v-for="(p, i) in players" :key="p.id">
				<view class="avatar" :style="{ background: avatarColors[i % avatarColors.length] }">
					<text>{{ p.name.charAt(0) }}</text>
				</view>
				<view class="player-info">
					<text class="player-name">{{ p.name }}</text>
					<text class="player-chips">{{ p.chips }} 筹码</text>
				</view>
				<view class="player-actions">
					<text class="chip-btn chip-minus" @tap="showChipInput(p, -1)">－</text>
					<text class="chip-btn chip-plus" @tap="showChipInput(p, 1)">＋</text>
				</view>
			</view>
			<view class="empty-tip" v-if="players.length === 0">
				<text>暂无玩家，点击右下角 ＋ 添加</text>
			</view>
		</scroll-view>

		<view class="fab-add" @tap="showAddDialog">＋</view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'

interface Player {
	id: number
	name: string
	chips: number
}

interface ChipRecord {
	playerId: number
	delta: number
	balance: number
}

const players = ref<Player[]>([])
let nextId = 1
const undoStack = ref<ChipRecord[]>([])
const avatarColors = ['#FF6B6B', '#FF8E53', '#FFC107', '#4CAF50', '#42A5F5', '#AB47BC', '#EC407A']

onMounted(() => {
	loadData()
})

function loadData() {
	const saved = uni.getStorageSync('chip_players')
	if (saved) {
		try {
			players.value = JSON.parse(saved)
			if (players.value.length > 0) {
				nextId = Math.max(...players.value.map(p => p.id), 0) + 1
			}
		} catch (e) {
			players.value = []
		}
	} else {
		players.value = []
	}
}

function saveData() {
	uni.setStorageSync('chip_players', JSON.stringify(players.value))
}

/** 添加玩家：弹窗输入名字 + 底筹 */
function showAddDialog() {
	uni.showModal({
		title: '添加玩家',
		content: '请输入玩家名称',
		editable: true,
		placeholderText: '玩家名称',
		success: (res) => {
			if (!res.confirm || !res.content.trim()) return
			const name = res.content.trim()

			// 第二步：输入底筹
			uni.showModal({
				title: '初始筹码',
				content: '为「' + name + '」设置初始筹码',
				editable: true,
				placeholderText: '例如: 1000',
				success: (res2) => {
					if (!res2.confirm) return
					const chipsText = res2.content.trim()
					const chips = parseInt(chipsText)
					if (isNaN(chips) || chips < 0) {
						uni.showToast({ title: '请输入有效的正整数', icon: 'none' })
						return
					}
					players.value.push({ id: nextId++, name: name, chips: chips })
					saveData()
					uni.showToast({ title: '添加成功', icon: 'success' })
				}
			})
		}
	})
}

/** 加减筹码：弹窗输入自定义金额 */
function showChipInput(player: Player, sign: number) {
	const prefix = sign > 0 ? '加' : '减'
	const title = prefix + '筹码 — ' + player.name
	const placeholder = sign > 0 ? '输入增加金额' : '输入减少金额'

	uni.showModal({
		title: title,
		editable: true,
		placeholderText: placeholder,
		success: (res) => {
			if (!res.confirm) return
			const amountText = res.content.trim()
			const amount = parseInt(amountText)
			if (isNaN(amount) || amount <= 0) {
				uni.showToast({ title: '请输入有效的正整数', icon: 'none' })
				return
			}

			const delta = amount * sign
			const newChips = player.chips + delta
			if (newChips < 0) {
				uni.showToast({ title: '筹码不能为负数，当前只剩 ' + player.chips, icon: 'none' })
				return
			}

			player.chips = newChips
			undoStack.value.push({ playerId: player.id, delta: delta, balance: newChips })
			saveData()
			players.value = [...players.value]
			uni.showToast({ title: prefix + ' ' + amount + ' 筹码', icon: 'success' })
		}
	})
}

/** 撤销 */
function undo() {
	if (undoStack.value.length === 0) {
		uni.showToast({ title: '没有可撤销的操作', icon: 'none' })
		return
	}
	const last = undoStack.value.pop()!
	const player = players.value.find(p => p.id === last.playerId)
	if (player) {
		player.chips -= last.delta
		saveData()
		players.value = [...players.value]
		const action = last.delta > 0 ? '减' : '加'
		uni.showToast({ title: '撤销：' + player.name + ' ' + action + Math.abs(last.delta) + ' 筹码', icon: 'none' })
	}
}

/** 结算排名 */
function settle() {
	if (players.value.length === 0) {
		uni.showToast({ title: '没有玩家', icon: 'none' })
		return
	}
	const sorted = [...players.value].sort((a, b) => b.chips - a.chips)
	const medals = ['🥇', '🥈', '🥉']
	let msg = ''
	sorted.forEach((p, i) => {
		msg += (medals[i] || (i + 1) + '.') + ' ' + p.name + ' — ' + p.chips + ' 筹码\n'
	})
	const total = sorted.reduce((s, p) => s + p.chips, 0)
	msg += '\n共 ' + sorted.length + ' 人 | 总筹码 ' + total

	uni.showModal({
		title: '🏆 最终排名',
		content: msg,
		showCancel: false
	})
	undoStack.value = []
}
</script>

<style>
.page { padding: 0; background: #FFF5F5; min-height: 100vh; }
.action-bar { display: flex; justify-content: center; align-items: center; height: 80rpx; background: white; border-bottom: 2rpx solid #F0F0F0; }
.action-btn { color: #666; font-size: 28rpx; padding: 0 30rpx; }
.action-divider { color: #DDD; }

.list { padding: 16rpx 20rpx; max-height: calc(100vh - 160rpx); }

.player-card { display: flex; align-items: center; background: white; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.avatar text { color: white; font-size: 32rpx; font-weight: bold; }
.player-info { flex: 1; margin-left: 20rpx; }
.player-name { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.player-chips { font-size: 26rpx; color: #FF9800; margin-top: 6rpx; display: block; }

.player-actions { display: flex; gap: 12rpx; }
.chip-btn { width: 64rpx; height: 64rpx; border-radius: 50%; text-align: center; line-height: 64rpx; font-size: 36rpx; font-weight: bold; color: white; }
.chip-minus { background: #F44336; }
.chip-plus { background: #4CAF50; }

.fab-add { position: fixed; right: 40rpx; bottom: 40rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #FF6B6B; color: white; text-align: center; line-height: 100rpx; font-size: 56rpx; box-shadow: 0 4rpx 16rpx rgba(255,107,107,0.4); }
.empty-tip { text-align: center; color: #BBB; font-size: 28rpx; margin-top: 120rpx; }
</style>
