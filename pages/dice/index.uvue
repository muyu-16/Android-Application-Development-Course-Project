<template>
	<view class="page">
		<text class="page-title">🎲 掷骰子</text>

		<view class="dice-container" @tap="roll">
			<view class="dice-face"
				:style="{
					transform: 'rotate(' + rotation + 'deg) scale(' + scale + ')',
					transition: 'all 0.5s ease'
				}">
				<view class="dice-dot" v-for="(pos, i) in dotPositions[currentValue]" :key="i"
					:style="{ left: pos.x + '%', top: pos.y + '%' }">
				</view>
			</view>
		</view>

		<text class="result-text">{{ resultText }}</text>

		<button class="btn btn-primary" :disabled="isRolling" @tap="roll">
			{{ isRolling ? '转动中...' : '🎲 掷骰子' }}
		</button>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const currentValue = ref(1)
const resultText = ref('点击按钮掷骰子')
const isRolling = ref(false)
const rotation = ref(0)
const scale = ref(1)

const dotPositions: Record<number, Array<{ x: number; y: number }>> = {
	1: [{ x: 50, y: 50 }],
	2: [{ x: 25, y: 25 }, { x: 75, y: 75 }],
	3: [{ x: 25, y: 25 }, { x: 50, y: 50 }, { x: 75, y: 75 }],
	4: [{ x: 25, y: 25 }, { x: 75, y: 25 }, { x: 25, y: 75 }, { x: 75, y: 75 }],
	5: [{ x: 25, y: 25 }, { x: 75, y: 25 }, { x: 50, y: 50 }, { x: 25, y: 75 }, { x: 75, y: 75 }],
	6: [{ x: 25, y: 20 }, { x: 75, y: 20 }, { x: 25, y: 50 }, { x: 75, y: 50 }, { x: 25, y: 80 }, { x: 75, y: 80 }]
}

function roll() {
	if (isRolling.value) return
	isRolling.value = true
	uni.vibrateShort({})

	const target = Math.floor(Math.random() * 6) + 1
	rotation.value = 1080
	scale.value = 1.3

	setTimeout(() => {
		currentValue.value = target
		resultText.value = '🎯 点数：' + target
		rotation.value = 0
		scale.value = 1
		isRolling.value = false
	}, 500)
}
</script>

<style>
.page { padding: 30rpx; background: #FFF5F5; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
.page-title { font-size: 48rpx; font-weight: bold; color: #FF6B6B; margin-top: 40rpx; }
.dice-container { width: 320rpx; height: 320rpx; margin: 80rpx auto; }
.dice-face { width: 100%; height: 100%; background: #E53935; border-radius: 32rpx; position: relative; border: 6rpx solid #B71C1C; }
.dice-dot { position: absolute; width: 36rpx; height: 36rpx; background: white; border-radius: 50%; transform: translate(-50%, -50%); }
.result-text { font-size: 36rpx; color: #666; margin: 30rpx 0; }
.btn { width: 80%; height: 100rpx; line-height: 100rpx; border-radius: 50rpx; font-size: 36rpx; font-weight: bold; margin-top: 40rpx; }
.btn-primary { background: #FF6B6B; color: white; }
.btn:disabled { opacity: 0.6; }
</style>
